#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <chrono>

std::mutex cv_m;
std::condition_variable cv;
int i = 0;

void ThreadFunc(int id) {
    std::unique_lock<std::mutex> lk(cv_m);
    cv.wait(lk, [] { return i == 1; });
    std::cout << "Повідомлення з потоку " << id << std::endl;
}

void Notify() {
    std::this_thread::sleep_for(std::chrono::milliseconds(100));
    {
        std::lock_guard<std::mutex> lk(cv_m);
        i = 1;
    }
    std::cout << "[Notify] Викликаємо notify_one()...\n";
    cv.notify_one(); 
}

int main() {
    std::thread t1(ThreadFunc, 1);
    std::thread t2(ThreadFunc, 2);
    std::thread t3(ThreadFunc, 3);
    std::thread t_notify(Notify);

    t_notify.join();

    // Даємо час, потім чистимо залишкові потоки
    std::this_thread::sleep_for(std::chrono::milliseconds(100));
    cv.notify_all(); // Пробуджуємо решту, щоб join() пройшов без блокувань

    t1.join();
    t2.join();
    t3.join();

    return 0;
}
