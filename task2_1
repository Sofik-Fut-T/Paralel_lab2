#include <iostream>
#include <thread>
#include <mutex>
#include <queue>
#include <chrono>

std::queue<int> data_queue;
std::mutex m;
bool ready = false;

bool isPrime(int n) {
    if (n <= 1) return false;
    for (int i = 2; i * i <= n; ++i) {
        if (n % i == 0) return false;
    }
    return true;
}

void DataPreparation() {
    std::cout << "Введіть цілі числа (введіть -1 для завершення):\n";
    int val;
    while (std::cin >> val && val != -1) {
        std::lock_guard<std::mutex> lk(m);
        data_queue.push(val);
    }
    {
        std::lock_guard<std::mutex> lk(m);
        ready = true;
    }
    std::cout << "[DataPreparation] Введення завершено.\n";
}

void DataProcessing() {
    while (true) {
        std::unique_lock<std::mutex> lk(m);
        if (ready) {
            lk.unlock();
            break;
        }
        lk.unlock();
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }

    std::unique_lock<std::mutex> lk(m);
    std::cout << "[DataProcessing] Перевірка чисел на простоту:\n";
    while (!data_queue.empty()) {
        int num = data_queue.front();
        data_queue.pop();
        if (isPrime(num)) {
            std::cout << num << " - просте число\n";
        } else {
            std::cout << num << " - не просте число\n";
        }
    }
}

int main() {
    std::thread t1(DataPreparation);
    t1.detach();

    std::thread t2(DataProcessing);
    t2.join();

    return 0;
}
