#include <iostream>
#include <deque>
#include <future>
#include <thread>
#include <mutex>
#include <condition_variable>

bool isPrime(long long n) {
    if (n <= 1) return false;
    for (long long i = 2; i * i <= n; ++i) {
        if (n % i == 0) return false;
    }
    return true;
}

long long getNthPrime(int n) {
    int count = 0;
    long long num = 1;
    while (count < n) {
        num++;
        if (isPrime(num)) count++;
    }
    return num;
}

std::deque<std::packaged_task<long long()>> task_deque;
std::deque<int> num_deque;
std::mutex deque_mutex;
std::condition_variable deque_cv;
bool stop_worker = false;

void WorkerThread() {
    while (true) {
        std::packaged_task<long long()> task;
        int n = 0;

        {
            std::unique_lock<std::mutex> lk(deque_mutex);
            deque_cv.wait(lk, [] { return !task_deque.empty() || stop_worker; });

            if (stop_worker && task_deque.empty()) break;

            task = std::move(task_deque.front());
            task_deque.pop_front();
            n = num_deque.front();
            num_deque.pop_front();
        }

        task(); // Виконуємо завдання
        std::future<long long> res = task.get_future();
        std::cout << "\n[Worker] Завдання для n = " << n << " виконано. Результат: " << res.get() << "\n";
    }
}

int main() {
    std::thread worker(WorkerThread);

    while (true) {
        std::cout << "Введіть n (або -1 для завершення): ";
        int n;
        std::cin >> n;
        if (n == -1) break;

        std::packaged_task<long long()> task([n]() { return getNthPrime(n); });

        {
            std::lock_guard<std::mutex> lk(deque_mutex);
            task_deque.push_back(std::move(task));
            num_deque.push_back(n);
        }
        deque_cv.notify_one();
    }

    {
        std::lock_guard<std::mutex> lk(deque_mutex);
        stop_worker = true;
    }
    deque_cv.notify_all();

    if (worker.joinable()) worker.join();

    std::cout << "Роботу програми завершено.\n";
    return 0;
}
